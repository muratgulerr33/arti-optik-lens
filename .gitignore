# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local artifacts
masterpack-tools.zip

# secrets
.env
.env.*

# seed data (gerçek data commit edilmez, sadece sample commit edilir)
tools/seed/input/*.full.json
tools/seed/input/*.full.csv
# Sample dosya commit edilebilir: tools/seed/input/v1-seed.sample.json

# Forensics / scratch (do not commit raw dumps)
docs/forensics/raw-sql/
