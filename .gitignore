# ---------------------------------------------
# ARTI OPTIK — .gitignore (clean commit)
# ---------------------------------------------

# macOS / OS junk
.DS_Store
.AppleDouble
.LSOverride
Icon?

# IDE / Editor
.vscode/
.idea/
*.iml

# Node / package managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Next.js / build outputs
.next/
out/
.turbo/
build/
dist/

# Hosting platforms
.vercel/

# Tests / coverage / Playwright
coverage/
playwright-report/
test-results/

# TypeScript incremental build
*.tsbuildinfo

# Env files (secrets)
.env
.env.*
.env.local
.env.*.local

# Allow safe examples to be committed
!.env.example
!.env.sample
!.env.template

# Local artifacts / zips
masterpack-tools.zip

# Large raw imports / bundles (commit disi)
import-bundle*/
import-bundle-v1*/

# Forensics raw dumps (commit disi)
docs/forensics/raw*/
docs/forensics/raw/**

# Seed data policy:
# tools/seed/input altinda SADECE sample / README commit edilir, gercek data edilmez
tools/seed/input/*
!tools/seed/input/README.md
!tools/seed/input/.gitkeep
!tools/seed/input/v1-seed.sample.json
